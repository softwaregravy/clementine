# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler's machine-specific config, but keep the project's own.
/.bundle/*
!/.bundle/config

# Ignore all environment files. The example carries placeholder names only, and
# .envrc is direnv's shell setup — neither holds a credential.
/.env*
!/.env.example
!/.envrc

# Ignore project-local gems (BUNDLE_PATH).
/vendor/bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

