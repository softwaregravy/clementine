# Copy to .env for local development. Placeholder values only — never a real
# credential in a committed file, and .env itself is gitignored.
#
# In production these live in a Render environment group, except DATABASE_URL,
# which Render injects from the managed Postgres instance.

# Twilio — the send path. The account and number are John's step zero (DEC-079).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# NYC Open Data. Anonymous queries work; the token raises the rate limit.
SOCRATA_APP_TOKEN=your-socrata-app-token

# Local Postgres (the Docker server in CLAUDE.md's Commands section). Standard
# libpq names, so psql and Rails read the same values.
PGHOST=localhost
PGPORT=5432
PGUSER=clementine
PGPASSWORD=local-dev-password
